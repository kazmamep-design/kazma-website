# Workers Static Assets default to revalidation-safe HTML caching. Only static
# resources receive extended browser caching here.
/home.css
  Cache-Control: public, max-age=31536000, immutable

/style.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/script.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.avif
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable
